{
  "name": "chess-arena-desktop",
  "version": "1.2.7",
  "private": true,
  "description": "Chess Arena — complete app with Stockfish, bots, accounts, Elo and WebSocket matchmaking",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/copy-engine.mjs",
    "copy:engine": "node scripts/copy-engine.mjs",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "dist:mac-universal": "npm run build && electron-builder --mac dmg --universal",
    "server": "node server/server.cjs",
    "server:dev": "node --watch server/server.cjs",
    "dist:mac-arm64": "npm run build && electron-builder --mac dmg --arm64",
    "dev:web": "vite --host 127.0.0.1 --port 8173 --strictPort",
    "preview": "vite --host 127.0.0.1 --port 8173 --strictPort"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "9.2.1",
    "electron": "39.0.0",
    "electron-builder": "26.0.12",
    "vite": "7.1.12",
    "wait-on": "8.0.4",
    "stockfish": "19.0.1"
  },
  "build": {
    "appId": "com.chessarena.desktop",
    "productName": "Chess Arena",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Chess-Arena-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "artifactName": "Chess-Arena-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    }
  }
}
